<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>RC_AlienHiveVisageAura</defName>
    <label>лик чуждого роя</label>
    <description>Отталкивающий облик носителя оставляет тяжёлое впечатление на окружающих.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <allowMothballIfLowPriorityWorldPawn>true</allowMothballIfLowPriorityWorldPawn>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="RedCrow.InsectorTweaks.HediffCompProperties_SourceAura">
        <radius>6</radius>
        <tickInterval>500</tickInterval>
        <thoughtDef>RC_AlienHiveVisageMemory</thoughtDef>
        <excludedGene>RC_Mutation_AlienHiveVisage</excludedGene>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>RC_PheromoneUnity</defName>
    <label>феромонное единение</label>
    <description>Феромонные железы усиливают социальное присутствие носителя, но раздражают окружающие ткани.</description>
    <scenarioCanAdd>false</scenarioCanAdd>
    <allowMothballIfLowPriorityWorldPawn>true</allowMothballIfLowPriorityWorldPawn>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <stages>
      <li>
        <painOffset>0.0125</painOffset>
        <statOffsets>
          <SocialImpact>0.25</SocialImpact>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>RC_HiveElectroOrgan</defName>
    <label>электроорган улья</label>
    <description>Техноорганические катушки передают накопленную энергию ближайшим батареям.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <allowMothballIfLowPriorityWorldPawn>true</allowMothballIfLowPriorityWorldPawn>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="AnimalBehaviours.HediffCompProperties_Electrified">
        <electroRate>40</electroRate>
        <electroRadius>5</electroRadius>
        <electroChargeAmount>1</electroChargeAmount>
        <batteriesToAffect>
          <li>Battery</li>
          <li>Battery_Silver</li>
          <li>Battery_Gold</li>
          <li>Battery_Plasteel</li>
          <li>Battery_Uranium</li>
          <li>Battery_Advanced</li>
          <li>Battery_Vanometric</li>
          <li>Battery4k</li>
          <li>Battery16k</li>
          <li>Battery64k</li>
          <li>Battery256k</li>
          <li>ChargeBack_Battery_Prototype</li>
          <li>ChargeBack_Battery</li>
          <li>SpeedCharge_Battery</li>
          <li>ResonanceCell_Battery</li>
          <li>VoidCell_Battery</li>
          <li>VFE_LargeBattery</li>
          <li>VFE_SmallBattery</li>
          <li>VFE_AdvancedBattery</li>
          <li>VFE_LargeAdvancedBattery</li>
          <li>AA_BlueGelBattery</li>
          <li>AA_HexaGelBattery</li>
          <li>ShipCapacitor</li>
          <li>ShipCapacitorSmall</li>
        </batteriesToAffect>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>RC_MatriarchCalmAura</defName>
    <label>аура маточного покоя</label>
    <description>Психическое поле носителя успокаивает окружающих.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <allowMothballIfLowPriorityWorldPawn>true</allowMothballIfLowPriorityWorldPawn>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="RedCrow.InsectorTweaks.HediffCompProperties_SourceAura">
        <radius>6</radius>
        <tickInterval>500</tickInterval>
        <thoughtDef>RC_MatriarchCalmMemory</thoughtDef>
        <excludedGene>RC_Evolution_MatriarchCalmAura</excludedGene>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>RC_SegmentRestoration</defName>
    <label>восстановление сегментов</label>
    <description>Регенеративные ткани медленно лечат повреждённые и восстанавливают утраченные внешние части тела.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <allowMothballIfLowPriorityWorldPawn>true</allowMothballIfLowPriorityWorldPawn>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="RedCrow.InsectorTweaks.HediffCompProperties_SegmentRegeneration">
        <rateInTicks>55000~65000</rateInTicks>
        <healAmount>1</healAmount>
      </li>
    </comps>
  </HediffDef>

</Defs>
