<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>RC_UsurpationLarva</defName>
    <label>usurpation larva</label>
    <description>A parasitic hive larva is infiltrating the nervous system and progressively taking control of the host.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>0.001</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="RedCrow.InsectorTweaks.HediffCompProperties_UsurpationLarva">
        <metapodDef>RC_Metapod_Usurpation</metapodDef>
        <comaDef>RC_UsurpationComa</comaDef>
        <incubationTicks>300000</incubationTicks>
        <comaTicks>60000</comaTicks>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
      </li>
      <li>
        <minSeverity>0.2</minSeverity>
        <painOffset>0.1</painOffset>
        <hungerRateFactor>1.2</hungerRateFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.82</postFactor>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <painOffset>0.2</painOffset>
        <hungerRateFactor>1.4</hungerRateFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.64</postFactor>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <painOffset>0.3</painOffset>
        <hungerRateFactor>1.6</hungerRateFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.46</postFactor>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <painOffset>0.4</painOffset>
        <hungerRateFactor>1.8</hungerRateFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.28</postFactor>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>1</minSeverity>
        <painOffset>0.5</painOffset>
        <hungerRateFactor>2</hungerRateFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>RC_UsurpationComa</defName>
    <label>usurpation coma</label>
    <description>The larva has seized the host's nervous system. After one day, the body will automatically enter an usurpation metapod.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>1</initialSeverity>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.01</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>RC_SolarStuporCondition</defName>
    <label>permanent solar stupor</label>
    <description>Direct sunlight suppresses neural activity and limits consciousness to 10%. The condition is inactive at night and under a roof, and is preserved by RedCrow metapod health renewal.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>0.1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <allowMothballIfLowPriorityWorldPawn>true</allowMothballIfLowPriorityWorldPawn>
    <comps>
      <li Class="RedCrow.InsectorTweaks.HediffCompProperties_SolarStuporCondition" />
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
      </li>
      <li>
        <minSeverity>1</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>RC_SwarmConsumed</defName>
    <label>consumed by the hive</label>
    <description>The pawn's individual mind has dissolved into the hive. Human attachments and ordinary moods no longer guide it; the body exists as a hungry node of the collective.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <everCurableByItem>false</everCurableByItem>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <isBad>false</isBad>
    <disablesNeeds>
      <li>Mood</li>
      <li>Joy</li>
      <li>Beauty</li>
      <li>Outdoors</li>
    </disablesNeeds>
    <aptitudes>
      <Animals>-12</Animals>
      <Social>-12</Social>
      <Artistic>-12</Artistic>
    </aptitudes>
    <stages>
      <li>
        <painOffset>-0.5</painOffset>
        <opinionOfOthersFactor>0</opinionOfOthersFactor>
        <statFactors>
          <Suppressability>0.5</Suppressability>
        </statFactors>
        <statOffsets>
          <ComfyTemperatureMin>-16</ComfyTemperatureMin>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
