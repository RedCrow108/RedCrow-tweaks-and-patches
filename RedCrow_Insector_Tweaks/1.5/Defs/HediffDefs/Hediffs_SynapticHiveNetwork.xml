<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>RC_SynapticNetworkState</defName>
    <label>organic synaptic network</label>
    <description>The pawn's nervous system is being sustained by an organic synaptic node on the current map.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <isBad>false</isBad>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>signal collapse</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.01</setMax>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.11</minSeverity>
        <label>critical signal</label>
        <statFactors>
          <MoveSpeed>0.5</MoveSpeed>
          <WorkSpeedGlobal>0.5</WorkSpeedGlobal>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.25</minSeverity>
        <label>stable signal</label>
      </li>
      <li>
        <minSeverity>0.51</minSeverity>
        <label>enhanced signal</label>
        <statFactors>
          <WorkSpeedGlobal>1.1</WorkSpeedGlobal>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.76</minSeverity>
        <label>saturated signal</label>
        <statFactors>
          <WorkSpeedGlobal>1.2</WorkSpeedGlobal>
        </statFactors>
        <statOffsets>
          <MoveSpeed>1</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>RC_DeferredSynapticShock</defName>
    <label>deferred synaptic shock</label>
    <description>The swarm's severed neural echo will force this pawn into a berserk rage as soon as it can act.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <isBad>true</isBad>
    <comps>
      <li Class="RedCrow.InsectorTweaks.HediffCompProperties_DeferredSynapticShock" />
    </comps>
  </HediffDef>

</Defs>
