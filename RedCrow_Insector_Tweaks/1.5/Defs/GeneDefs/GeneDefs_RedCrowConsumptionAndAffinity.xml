  <VanillaRacesExpandedInsector.GenelineGeneDef ParentName="RC_OrgansMutationBase">
    <defName>RC_Mutation_RavenousCrop</defName>
    <label>ravenous crop</label>
    <description>An enlarged foregut keeps demanding fresh nutrients even after the rest of the body is satisfied.</description>
    <displayOrderInCategory>3571</displayOrderInCategory>
    <mutation>3</mutation>
    <customEffectDescriptions>
      <li>Food need drain: +0.1 to the combined RedCrow factor.</li>
    </customEffectDescriptions>
    <exclusionTags>
      <li>RC_FoodP01_N01</li>
      <li>RC_FoodP01_N02</li>
    </exclusionTags>
    <modExtensions Inherit="False">
      <li Class="RedCrow.InsectorTweaks.RC_HungerGeneExtension">
        <hungerAdditive>0.1</hungerAdditive>
      </li>
      <li Class="VanillaGenesExpanded.GeneExtension">
        <backgroundPathEndogenes>UI/Icons/Genes/VRE_MutationBG</backgroundPathEndogenes>
        <backgroundPathXenogenes>UI/Icons/Genes/VRE_MutationBG</backgroundPathXenogenes>
      </li>
    </modExtensions>
  </VanillaRacesExpandedInsector.GenelineGeneDef>

