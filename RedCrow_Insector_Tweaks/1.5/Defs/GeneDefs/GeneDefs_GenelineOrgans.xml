  <VanillaRacesExpandedInsector.GenelineGeneDef
      ParentName="RC_OrgansMutationBase">
    <defName>RC_Mutation_HypertrophiedJellyAbdomen</defName>
    <label>hypertrophied jelly abdomen</label>
    <description>An enlarged abdominal organ produces fifty units of insect jelly per day. It is independent of the original jelly sacks and both organs can function together.</description>
    <displayOrderInCategory>3541</displayOrderInCategory>
    <mutation>5</mutation>
    <statOffsets>
      <MoveSpeed>-1</MoveSpeed>
    </statOffsets>
    <customEffectDescriptions>
      <li>Produces 50 insect jelly every 60000 ticks.</li>
      <li>Food need drain: x1.5 in the combined RedCrow formula.</li>
    </customEffectDescriptions>
    <renderNodeProperties>
      <li>
        <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
        <texPath>Things/Pawn/Humanlike/BodyAttachments/JellySacks</texPath>
        <colorType>Skin</colorType>
        <overrideMeshSize>1.75</overrideMeshSize>
        <parentTagDef>Body</parentTagDef>
        <shaderTypeDef>CutoutComplex</shaderTypeDef>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
          <defaultData>
            <layer>-3</layer>
          </defaultData>
          <dataNorth>
            <offset>(0, 0, -0.35)</offset>
            <layer>90</layer>
          </dataNorth>
          <dataSouth>
            <offset>(0, 0, -0.15)</offset>
          </dataSouth>
          <dataEast>
            <offset>(-0.5, 0, -0.15)</offset>
          </dataEast>
          <dataWest>
            <offset>(0.5, 0, -0.15)</offset>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>
    <modExtensions Inherit="False">
      <li Class="RedCrow.InsectorTweaks.RC_HungerGeneExtension">
        <hungerMultiplier>1.5</hungerMultiplier>
      </li>
      <li Class="VanillaGenesExpanded.GeneExtension">
        <backgroundPathEndogenes>UI/Icons/Genes/VRE_MutationBG</backgroundPathEndogenes>
        <backgroundPathXenogenes>UI/Icons/Genes/VRE_MutationBG</backgroundPathXenogenes>
        <hediffToWholeBody>RC_HypertrophiedJellyAbdomen</hediffToWholeBody>
      </li>
    </modExtensions>
  </VanillaRacesExpandedInsector.GenelineGeneDef>

  <VanillaRacesExpandedInsector.GenelineGeneDef
      ParentName="RC_OrgansMutationBase">
    <defName>RC_Mutation_BiologicalSickle</defName>
    <label>biological sickle</label>
    <description>Blunt harvesting plates act as a permanent biological sickle. They are not a weapon and cannot be dropped.</description>
    <displayOrderInCategory>3551</displayOrderInCategory>
    <mutation>2</mutation>
    <customEffectDescriptions>
      <li>Plant work speed: +30%, or the strongest equipped-tool effect.</li>
      <li>Food need drain: +0.2 to the combined RedCrow factor.</li>
    </customEffectDescriptions>
