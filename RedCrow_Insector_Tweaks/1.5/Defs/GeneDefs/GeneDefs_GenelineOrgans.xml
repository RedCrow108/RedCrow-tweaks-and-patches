    <defName>RC_Mutation_BiologicalHammer</defName>
    <label>biological hammer</label>
    <description>Heavy chitin impact plates serve as a permanent biological construction and smithing tool without becoming a weapon.</description>
    <displayOrderInCategory>3554</displayOrderInCategory>
    <mutation>3</mutation>
    <customEffectDescriptions>
