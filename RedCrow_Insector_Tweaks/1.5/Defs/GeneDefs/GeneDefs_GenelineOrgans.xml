    <description>Reinforced non-combat digging plates function as a permanent biological earthworking tool.</description>
    <displayOrderInCategory>3552</displayOrderInCategory>
    <mutation>3</mutation>
    <customEffectDescriptions>
      <li>Plant work and mining speed: +30%, or the strongest equipped-tool effect.</li>
