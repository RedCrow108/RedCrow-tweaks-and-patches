  <VanillaRacesExpandedInsector.GenelineGeneDef
      ParentName="RC_OrgansMutationBase">
    <defName>RC_Mutation_PelvicWalkingLimbs</defName>
    <label>pelvic walking limbs</label>
    <description>An additional load-bearing pair of pelvic limbs improves movement and supports physical work.</description>
    <displayOrderInCategory>3531</displayOrderInCategory>
    <mutation>4</mutation>
    <statOffsets>
      <WorkSpeedGlobal>0.20</WorkSpeedGlobal>
      <MoveSpeed>0.5</MoveSpeed>
    </statOffsets>
    <customEffectDescriptions>
      <li>Food need drain: +0.6 to the combined RedCrow factor.</li>
    </customEffectDescriptions>
    <renderNodeProperties>
      <li>
        <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
        <texPath>Things/Pawn/Humanlike/BodyAttachments/RC_PelvicWalkingLimbs</texPath>
        <overrideMeshSize>0.95</overrideMeshSize>
        <parentTagDef>Body</parentTagDef>
        <shaderTypeDef>CutoutComplex</shaderTypeDef>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
