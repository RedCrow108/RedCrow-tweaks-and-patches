  <VanillaRacesExpandedInsector.GenelineGeneDef
      ParentName="RC_OrgansEvolutionBase">
    <defName>RC_Evolution_EfficientHiveMetabolism</defName>
    <label>efficient hive metabolism</label>
    <description>A redesigned digestive cycle halves the carrier's food-need drain. RedCrow hunger modifiers are combined before other game and mod effects.</description>
    <displayOrderInCategory>3501</displayOrderInCategory>
    <evolution>4</evolution>
    <customEffectDescriptions>
      <li>Food need drain: x0.5.</li>
    </customEffectDescriptions>
    <exclusionTags>
      <li>RC_Conflict_HiveMetabolism</li>
    </exclusionTags>
    <modExtensions Inherit="False">
      <li Class="RedCrow.InsectorTweaks.RC_HungerGeneExtension">
        <hungerMultiplier>0.5</hungerMultiplier>
      </li>
      <li Class="VanillaGenesExpanded.GeneExtension">
        <backgroundPathEndogenes>UI/Icons/Genes/VRE_EvolutionBG</backgroundPathEndogenes>
        <backgroundPathXenogenes>UI/Icons/Genes/VRE_EvolutionBG</backgroundPathXenogenes>
      </li>
    </modExtensions>
  </VanillaRacesExpandedInsector.GenelineGeneDef>

  <VanillaRacesExpandedInsector.GenelineGeneDef
      ParentName="RC_OrgansEvolutionBase"
      MayRequire="VanillaExpanded.VPsycastsE">
    <defName>RC_Evolution_HivePsyfocusRecycling</defName>
    <label>hive psyfocus recycling</label>
    <description>Specialized neural loops reclaim half of the psyfocus normally lost when casting psycasts.</description>
    <displayOrderInCategory>3502</displayOrderInCategory>
    <evolution>4</evolution>
    <statFactors>
      <VPE_PsyfocusCostFactor>0.5</VPE_PsyfocusCostFactor>
    </statFactors>
  </VanillaRacesExpandedInsector.GenelineGeneDef>

  <VanillaRacesExpandedInsector.GenelineGeneDef
      ParentName="RC_OrgansMutationBase">
    <defName>RC_Mutation_SmallThoracicArms</defName>
    <label>small thoracic arms</label>
    <description>A short secondary pair of chest arms assists ordinary manipulation without functioning as a weapon.</description>
    <displayOrderInCategory>3511</displayOrderInCategory>
    <mutation>2</mutation>
    <statOffsets>
      <WorkSpeedGlobal>0.10</WorkSpeedGlobal>
    </statOffsets>
    <customEffectDescriptions>
      <li>Food need drain: +0.2 to the combined RedCrow factor.</li>
    </customEffectDescriptions>
    <renderNodeProperties>
      <li>
        <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
        <texPath>Things/Pawn/Humanlike/BodyAttachments/RC_SmallThoracicArms</texPath>
        <overrideMeshSize>0.82</overrideMeshSize>
        <parentTagDef>Body</parentTagDef>
        <shaderTypeDef>CutoutComplex</shaderTypeDef>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
          <defaultData>
            <layer>20</layer>
            <offset>(0, 0, -0.08)</offset>
          </defaultData>
        </drawData>
      </li>
    </renderNodeProperties>
    <modExtensions Inherit="False">
      <li Class="RedCrow.InsectorTweaks.RC_HungerGeneExtension">
        <hungerAdditive>0.2</hungerAdditive>
      </li>
      <li Class="VanillaGenesExpanded.GeneExtension">
        <backgroundPathEndogenes>UI/Icons/Genes/VRE_MutationBG</backgroundPathEndogenes>
        <backgroundPathXenogenes>UI/Icons/Genes/VRE_MutationBG</backgroundPathXenogenes>
      </li>
    </modExtensions>
  </VanillaRacesExpandedInsector.GenelineGeneDef>

  <VanillaRacesExpandedInsector.GenelineGeneDef
      ParentName="RC_OrgansMutationBase">
    <defName>RC_Mutation_DorsalManipulators</defName>
