<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Alpha Genes</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>Defs/VanillaRacesExpandedInsector.GenelineGeneDef[defName="RC_Mutation_AlienHiveVisage"]/iconPath</xpath>
          <value>
            <iconPath>UI/Icons/Genes/AG_UnfathomablyUgly</iconPath>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/VanillaRacesExpandedInsector.GenelineGeneDef[defName="RC_Evolution_PheromoneUnity"]/iconPath</xpath>
          <value>
            <iconPath>UI/Icons/Genes/AGI_PheromonalSecretor</iconPath>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/VanillaRacesExpandedInsector.GenelineGeneDef[defName="RC_Mutation_HiveElectroOrgan"]/iconPath</xpath>
          <value>
            <iconPath>UI/Icons/Genes/AG_TetraCoilsIcon</iconPath>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/VanillaRacesExpandedInsector.GenelineGeneDef[defName="RC_Mutation_ThreatMark"]/iconPath</xpath>
          <value>
            <iconPath>UI/Icons/Genes/AG_DangerousPresence</iconPath>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/VanillaRacesExpandedInsector.GenelineGeneDef[defName="RC_Evolution_MatriarchCalmAura"]/iconPath</xpath>
          <value>
            <iconPath>UI/Icons/Genes/AG_MasterfulPsychic</iconPath>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/VanillaRacesExpandedInsector.GenelineGeneDef[defName="RC_Mutation_DoomOmen"]/iconPath</xpath>
          <value>
            <iconPath>UI/Icons/Genes/AG_DeadlyPresence</iconPath>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/VanillaRacesExpandedInsector.GenelineGeneDef[defName="RC_Evolution_SegmentRestoration"]/iconPath</xpath>
          <value>
            <iconPath>UI/Icons/Genes/AG_LimbRegeneration</iconPath>
          </value>
        </li>

        <li Class="PatchOperationAdd">
          <xpath>Defs/VanillaRacesExpandedInsector.GenelineGeneDef[defName="RC_Mutation_HiveElectroOrgan"]</xpath>
          <value>
            <renderNodeProperties>
              <li>
                <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
                <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
                <parentTagDef>Head</parentTagDef>
                <texPath>Things/Pawn/Humanlike/HeadAttachments/AG_TetraCoils/AG_TetraCoils</texPath>
                <drawData>
                  <defaultData>
                    <layer>80</layer>
                  </defaultData>
                </drawData>
              </li>
            </renderNodeProperties>
          </value>
        </li>

        <li Class="PatchOperationConditional">
          <xpath>Defs/GeneDef[defName="AG_VFEI_PheromoneSecretor"]</xpath>
          <match Class="PatchOperationConditional">
            <xpath>Defs/GeneDef[defName="AG_VFEI_PheromoneSecretor"]/exclusionTags</xpath>
            <match Class="PatchOperationAdd">
              <xpath>Defs/GeneDef[defName="AG_VFEI_PheromoneSecretor"]/exclusionTags</xpath>
              <value>
                <li>RC_PheromoneSecretor</li>
              </value>
            </match>
            <nomatch Class="PatchOperationAdd">
              <xpath>Defs/GeneDef[defName="AG_VFEI_PheromoneSecretor"]</xpath>
              <value>
                <exclusionTags>
                  <li>RC_PheromoneSecretor</li>
                </exclusionTags>
              </value>
            </nomatch>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/GeneDef[defName="AG_TetraCoils"]</xpath>
          <match Class="PatchOperationConditional">
            <xpath>Defs/GeneDef[defName="AG_TetraCoils"]/exclusionTags</xpath>
            <match Class="PatchOperationAdd">
              <xpath>Defs/GeneDef[defName="AG_TetraCoils"]/exclusionTags</xpath>
              <value>
                <li>RC_TeslaOrgan</li>
              </value>
            </match>
            <nomatch Class="PatchOperationAdd">
              <xpath>Defs/GeneDef[defName="AG_TetraCoils"]</xpath>
              <value>
                <exclusionTags>
                  <li>RC_TeslaOrgan</li>
                </exclusionTags>
              </value>
            </nomatch>
          </match>
        </li>
      </operations>
    </match>
  </Operation>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>VRE Hussar (HSK/CE Patched)</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>Defs/VanillaRacesExpandedInsector.GenelineGeneDef[defName="RC_Evolution_UnconstrainedCarapace"]/iconPath</xpath>
          <value>
            <iconPath>UI/GeneIcons/Gene_Unconstrained</iconPath>
          </value>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/GeneDef[defName="VREH_Unconstrained"]</xpath>
          <match Class="PatchOperationConditional">
            <xpath>Defs/GeneDef[defName="VREH_Unconstrained"]/exclusionTags</xpath>
            <match Class="PatchOperationAdd">
              <xpath>Defs/GeneDef[defName="VREH_Unconstrained"]/exclusionTags</xpath>
              <value>
                <li>RC_ApparelMovePenaltyImmunity</li>
              </value>
            </match>
            <nomatch Class="PatchOperationAdd">
              <xpath>Defs/GeneDef[defName="VREH_Unconstrained"]</xpath>
              <value>
                <exclusionTags>
                  <li>RC_ApparelMovePenaltyImmunity</li>
                </exclusionTags>
              </value>
            </nomatch>
          </match>
        </li>
      </operations>
    </match>
  </Operation>

</Patch>
