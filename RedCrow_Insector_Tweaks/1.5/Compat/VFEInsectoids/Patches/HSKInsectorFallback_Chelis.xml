<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/VanillaRacesExpandedInsector.GenelineGeneDef[defName="VRE_LocustWings"]</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs</xpath>
      <value>
        <VanillaRacesExpandedInsector.GenelineGeneDef ParentName="VRE_EvolutionGene">
          <defName>VRE_LocustWings</defName>
          <label>locust wings</label>
          <description>Carriers of this gene develop locust wings, granting them the special ability to perform a locust leap. This allows them to fly short distances, emulating the powerful and agile leaps of a locust.</description>
          <unlockable>false</unlockable>
          <iconPath>UI/Icons/Genes/Gene_LocustWings</iconPath>
          <displayOrderInCategory>1004</displayOrderInCategory>
          <selectionWeight>0</selectionWeight>
          <abilities>
            <li>VFEI2_InsectGlide_Far_Colonists</li>
          </abilities>
          <exclusionTags>
            <li>InsectorMovement</li>
          </exclusionTags>
          <renderNodeProperties>
            <li>
              <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
              <texPath>Things/Pawn/Humanlike/BodyAttachments/Locustwings</texPath>
              <drawSize>1</drawSize>
              <parentTagDef>Body</parentTagDef>
              <colorType>Skin</colorType>
              <shaderTypeDef>CutoutComplex</shaderTypeDef>
              <useRottenColor>true</useRottenColor>
              <useSkinShader>true</useSkinShader>
              <rotDrawMode>Fresh, Rotting</rotDrawMode>
              <drawData>
                <defaultData>
                  <layer>-2</layer>
                </defaultData>
                <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
                <dataNorth>
                  <layer>90</layer>
                </dataNorth>
                <dataEast>
                  <offset>(-0.2, 0, 0)</offset>
                </dataEast>
                <dataWest>
                  <offset>(0.2, 0, 0)</offset>
                </dataWest>
              </drawData>
            </li>
          </renderNodeProperties>
          <symbolPack>
            <prefixSymbols>
              <li>
                <symbol>fly</symbol>
              </li>
              <li>
                <symbol>jump</symbol>
              </li>
            </prefixSymbols>
            <suffixSymbols>
              <li>
                <symbol>runner</symbol>
              </li>
              <li>
                <symbol>jumper</symbol>
              </li>
              <li>
                <symbol>flier</symbol>
              </li>
              <li>
                <symbol>fly</symbol>
              </li>
            </suffixSymbols>
          </symbolPack>
          <modExtensions>
            <li Class="VanillaGenesExpanded.GeneExtension">
              <backgroundPathEndogenes>UI/Icons/Genes/VRE_EvolutionBG</backgroundPathEndogenes>
              <backgroundPathXenogenes>UI/Icons/Genes/VRE_EvolutionBG</backgroundPathXenogenes>
            </li>
          </modExtensions>
        </VanillaRacesExpandedInsector.GenelineGeneDef>
      </value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/VanillaRacesExpandedInsector.GenelineGeneDef[defName="VRE_InsectRostrum"]</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs</xpath>
      <value>
        <VanillaRacesExpandedInsector.GenelineGeneDef ParentName="VRE_EvolutionGene">
          <defName>VRE_InsectRostrum</defName>
          <label>insect rostrum</label>
          <labelShortAdj>mandibled</labelShortAdj>
          <description>Carriers of this gene possess an insect rostrum, a large, sharp beak-like structure akin to that of bees. This adaptation quadruples their eating speed and grants them a powerful melee bite attack, dealing significant stab damage with a quick cooldown.</description>
          <unlockable>false</unlockable>
          <iconPath>UI/Icons/Genes/Gene_InsectRostrum</iconPath>
          <displayOrderInCategory>1005</displayOrderInCategory>
          <statFactors>
            <EatingSpeed>4</EatingSpeed>
          </statFactors>
          <exclusionTags>
            <li>InsectorMouth</li>
          </exclusionTags>
          <renderNodeProperties>
            <li>
              <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
              <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
              <parentTagDef>Head</parentTagDef>
              <texPath>Things/Pawn/Humanlike/HeadAttachments/InsectRostrum</texPath>
              <colorType>Skin</colorType>
              <useRottenColor>true</useRottenColor>
              <useSkinShader>true</useSkinShader>
              <rotDrawMode>Fresh, Rotting</rotDrawMode>
              <visibleFacing>
                <li>East</li>
                <li>South</li>
                <li>West</li>
              </visibleFacing>
              <drawData>
                <defaultData>
                  <layer>69</layer>
                </defaultData>
              </drawData>
            </li>
          </renderNodeProperties>
          <selectionWeight>0</selectionWeight>
          <symbolPack>
            <prefixSymbols>
              <li>
                <symbol>insect</symbol>
              </li>
              <li>
                <symbol>mandible</symbol>
              </li>
            </prefixSymbols>
          </symbolPack>
          <modExtensions>
            <li Class="VanillaGenesExpanded.GeneExtension">
              <backgroundPathEndogenes>UI/Icons/Genes/VRE_EvolutionBG</backgroundPathEndogenes>
              <backgroundPathXenogenes>UI/Icons/Genes/VRE_EvolutionBG</backgroundPathXenogenes>
              <hediffsToBodyParts>
                <li>
                  <hediff>VRE_InsectRostrum</hediff>
                  <bodyparts>
                    <li>Jaw</li>
                  </bodyparts>
                </li>
              </hediffsToBodyParts>
            </li>
          </modExtensions>
        </VanillaRacesExpandedInsector.GenelineGeneDef>
      </value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/VanillaRacesExpandedInsector.GenelineGeneDef[defName="VRE_InsectVolatile"]</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs</xpath>
      <value>
        <VanillaRacesExpandedInsector.GenelineGeneDef ParentName="VRE_MutationGene">
          <defName>VRE_InsectVolatile</defName>
          <label>volatile</label>
          <selectionWeight>0</selectionWeight>
          <description>Carriers of this gene exhibit volatile behavior, drastically increasing their likelihood of initiating social fights and ensuring their mental breaks are always violent when possible. They have a heightened tendency to attempt prison breaks and will use weapons in social confrontations.</description>
          <iconPath>UI/Icons/Genes/Gene_Volatile</iconPath>
          <unlockable>false</unlockable>
          <displayOrderInCategory>1004</displayOrderInCategory>
          <socialFightChanceFactor>2</socialFightChanceFactor>
          <aggroMentalBreakSelectionChanceFactor>999</aggroMentalBreakSelectionChanceFactor>
          <prisonBreakMTBFactor>0.3</prisonBreakMTBFactor>
          <customEffectDescriptions>
            <li>Will use weapons in social fights.</li>
          </customEffectDescriptions>
          <symbolPack>
            <prefixSymbols>
              <li>
                <symbol>aggro</symbol>
              </li>
              <li>
                <symbol>savage</symbol>
              </li>
              <li>
                <symbol>vola</symbol>
              </li>
            </prefixSymbols>
          </symbolPack>
          <modExtensions>
            <li Class="VanillaGenesExpanded.GeneExtension">
              <backgroundPathEndogenes>UI/Icons/Genes/VRE_MutationBG</backgroundPathEndogenes>
              <backgroundPathXenogenes>UI/Icons/Genes/VRE_MutationBG</backgroundPathXenogenes>
            </li>
          </modExtensions>
        </VanillaRacesExpandedInsector.GenelineGeneDef>
      </value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/VanillaRacesExpandedInsector.GenelineGeneDef[defName="VRE_EcdysoneOverdrive"]</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs</xpath>
      <value>
        <VanillaRacesExpandedInsector.GenelineGeneDef ParentName="VRE_MutationGene">
          <defName>VRE_EcdysoneOverdrive</defName>
          <label>ecdysone overdrive</label>
          <description>Carriers of this gene experience an ecdysone overdrive, creating a constant need for kill satiety. Prolonged periods without melee kills inflict increasing mood penalties, driving them towards violent confrontations to maintain their mental balance.</description>
          <iconPath>UI/Icons/Genes/Gene_EcdysoneOverdrive</iconPath>
          <unlockable>false</unlockable>
          <displayOrderInCategory>1005</displayOrderInCategory>
          <causesNeed>KillThirst</causesNeed>
          <selectionWeight>0</selectionWeight>
          <exclusionTags>
            <li>KillThirst</li>
          </exclusionTags>
          <symbolPack>
            <prefixSymbols>
              <li>
                <symbol>aggro</symbol>
              </li>
              <li>
                <symbol>killer</symbol>
              </li>
            </prefixSymbols>
          </symbolPack>
          <modExtensions>
            <li Class="VanillaGenesExpanded.GeneExtension">
              <backgroundPathEndogenes>UI/Icons/Genes/VRE_MutationBG</backgroundPathEndogenes>
              <backgroundPathXenogenes>UI/Icons/Genes/VRE_MutationBG</backgroundPathXenogenes>
            </li>
          </modExtensions>
        </VanillaRacesExpandedInsector.GenelineGeneDef>
      </value>
    </nomatch>
  </Operation>
</Patch>